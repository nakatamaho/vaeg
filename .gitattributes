* text=auto eol=lf

# VS/VC project machinery and cmd scripts stay CRLF
*.dsp  text eol=crlf
*.dsw  text eol=crlf
*.sln  text eol=crlf
*.vcproj  text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.bat  text eol=crlf

# Binary payloads - never renormalize, never diff as text
*.rom binary
*.bin binary
*.d88 binary
*.ico binary
*.cur binary
*.bmp binary
*.gif binary
*.png binary
*.ttf binary
*.wav binary
*.jpg binary
*.com binary

# Generated mail patch; embedded upstream context whitespace is patch data
docs/agents/reports/m35_suzukiplan_irq_extension.patch -diff

# Unified source patch retains upstream tab-indented context as patch data
tools/cpmva/patches/cpm22-64k.patch -diff

# M140 unified-diff context is byte-exact patch data, not source indentation.
# Keep these patches text-diffable; relax only context-specific whitespace.
external/zex/patches/m140-fdc-zexall.patch whitespace=-blank-at-eol,-space-before-tab
external/zex/patches/m140-fdc-neg-smoke.patch whitespace=-blank-at-eol,-space-before-tab
# M140 mail-patch context/signature whitespace is data; keep the patch diffable.
docs/agents/reports/m140_upstream_upd780c1_profile.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Byte-identical legal evidence retains its historical line whitespace
LICENSES/legacy-vaeg.txt whitespace=-blank-at-eol

# Pinned upstream GL loader retains its generated Khronos license whitespace
external/imgui/backends/imgui_impl_opengl3_loader.h whitespace=-blank-at-eol

# M101 byte-exact CP/M output evidence (CRLF, 1Ah padding); never convert
docs/agents/reports/m101_zexall_qa/*/raw/** binary

# M102 byte-exact CP/M output evidence
docs/agents/reports/m102_zexund_qa/*/raw/** binary
docs/agents/reports/m103a_altregs_qa/*/raw/** binary
