# This is a neutral M74 debug script. The caller supplies the local bootable
# disk separately; no private asset identity is stored here.
debug-script 1
limit-frame 3000
wait-frame 1200
input-line GLASSP5
wait-pc 2000:0100 1
capture ga5-idle registers screen
exit
