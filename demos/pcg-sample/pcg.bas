140 OUT 15,&H36:OUT 2,8
150 FOR X=0 TO 7:READ N
160 OUT 12,N AND 255:OUT 12,INT(N/256)
170 LOCATE X*4,5:PRINT " ";CHR$(128);CHR$(129)
180 FOR W=1 TO 600:NEXT W
190 NEXT X:OUT 2,0:END
