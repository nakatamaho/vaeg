100 FOR C=0 TO 3:FOR R=0 TO 7:READ D
110 A=C*8+R:H=INT(A/256):OUT 0,D:OUT 1,A AND 255:OUT 2,H:OUT 2,H OR 16:OUT 2,H
120 NEXT R,C:OUT 2,0
