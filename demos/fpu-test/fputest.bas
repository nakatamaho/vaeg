20 ' N88 BASIC V3.1 8087 CHECK: BASIC /87, THEN RUN
100 DEFDBL A-Z
110 PRINT "8087 BASIC TEST (error = |value-exact|/|exact|, OK below 1E-14)"
130 N$="ATN(1/2)":V=ATN(1#/2#):R=.463647609000806116#:GOSUB 1000
140 N$="ATN(74/75)":V=ATN(74#/75#):R=.778686854766125705#:GOSUB 1000
150 N$="ATN(1)*4":V=ATN(1#)*4#:R=3.14159265358979324#:GOSUB 1000
160 N$="TAN(.25)":V=TAN(.25#):R=.255341921221036267#:GOSUB 1000
170 N$="SIN(.5)":V=SIN(.5#):R=.479425538604203#:GOSUB 1000
180 N$="COS(.5)":V=COS(.5#):R=.877582561890372716#:GOSUB 1000
190 N$="EXP(1)":V=EXP(1#):R=2.71828182845904524#:GOSUB 1000
200 N$="EXP(.00001)":V=EXP(.00001#):R=1.00001000005000017#:GOSUB 1000
210 N$="EXP(-3.5)":V=EXP(-3.5#):R=.0301973834223185007#:GOSUB 1000
220 N$="LOG(3)":V=LOG(3#):R=1.09861228866810969#:GOSUB 1000
230 N$="LOG(1.25)":V=LOG(1.25#):R=.223143551314209756#:GOSUB 1000
240 N$="SQR(2)":V=SQR(2#):R=1.41421356237309505#:GOSUB 1000
250 N$="1/3*3":V=(1#/3#)*3#:R=1#:GOSUB 1000
260 PRINT "failed:";NG
270 END
1000 E=ABS(V-R)/ABS(R)
1010 IF E<1E-14 THEN S$="OK" ELSE S$="NG":NG=NG+1
1020 PRINT LEFT$(N$+SPACE$(12),12);" ";S$;"  ";V;"  error";CSNG(E)
1030 RETURN
